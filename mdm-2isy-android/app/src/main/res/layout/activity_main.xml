<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mdm_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/header_gradient"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingTop="30dp"
            android:paddingEnd="22dp"
            android:paddingBottom="28dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/logo_description"
                android:scaleType="fitCenter"
                android:src="@drawable/mdm_2isy_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/app_subtitle"
                    android:textColor="#F69323"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/protection_title"
                        android:textColor="@color/mdm_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/protection_subtitle"
                        android:textColor="@color/mdm_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/enrollmentStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/status_background"
                    android:text="@string/status_not_enrolled"
                    android:textColor="@color/mdm_blue_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/enrollmentPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enrollment_eyebrow"
                    android:textAllCaps="true"
                    android:textColor="@color/mdm_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/enrollment_title"
                    android:textColor="@color/mdm_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/enrollment_help"
                    android:textColor="@color/mdm_text_secondary"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/apiUrlInput"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/input_background"
                    android:hint="@string/api_url_hint"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:selectAllOnFocus="true"
                    android:textColor="@color/mdm_text"
                    android:textColorHint="@color/mdm_text_muted"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/enrollmentTokenInput"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/input_background"
                    android:hint="@string/enrollment_token_hint"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/mdm_text"
                    android:textColorHint="@color/mdm_text_muted" />

                <Button
                    android:id="@+id/enrollButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/primary_button"
                    android:backgroundTint="@null"
                    android:text="@string/enroll_action"
                    android:textAllCaps="false"
                    android:textColor="@color/mdm_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/device_eyebrow" android:textAllCaps="true" android:textColor="@color/mdm_blue" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/device_title" android:textColor="@color/mdm_text" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/deviceUidValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/mdm_text_secondary" android:textIsSelectable="true" android:textSize="13sp" />
                <TextView android:id="@+id/deviceOwnerValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/mdm_text" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/agentStateValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/mdm_text" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/lastSyncValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/mdm_text_secondary" android:textSize="13sp" />

                <Button
                    android:id="@+id/startAgentButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/primary_button"
                    android:backgroundTint="@null"
                    android:text="@string/start_agent_action"
                    android:textAllCaps="false"
                    android:textColor="@color/mdm_text"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/kioskButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/secondary_button"
                    android:backgroundTint="@null"
                    android:text="@string/kiosk_enable_action"
                    android:textAllCaps="false"
                    android:textColor="@color/mdm_blue_dark"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/messageValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/message_background"
                android:padding="16dp"
                android:textColor="@color/mdm_text"
                android:textIsSelectable="true"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
